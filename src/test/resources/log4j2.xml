<?xml version="1.0" encoding="UTF-8"?>
<!--
  Quietens the maze connector during tests. It warns once per room it can't fill, which is expected
  when the benchmark deliberately starves the connector of tile shapes.
-->
<Configuration status="OFF">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="reccomplex" level="ERROR"/>
        <Root level="ERROR">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
